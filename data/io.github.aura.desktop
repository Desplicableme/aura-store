[Desktop Entry]
Name=Aura
GenericName=App Store & Package Hub
Comment=Mac-inspired modern software hub and package explorer for Arch Linux
Exec=aura %U
Icon=io.github.aura
Terminal=false
Type=Application
Categories=System;PackageManager;Settings;Utility;
Keywords=pacman;paru;aur;store;apps;install;software;docker;flatpak;
StartupNotify=true
StartupWMClass=io.github.aura
MimeType=x-scheme-handler/appstream;
Actions=Updates;Docker;Installed;

[Desktop Action Updates]
Name=Check Updates
Exec=aura --updates

[Desktop Action Docker]
Name=Docker Applications
Exec=aura --docker

[Desktop Action Installed]
Name=Installed Applications
Exec=aura --installed
